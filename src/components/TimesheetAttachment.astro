---
import {formatAmount, formatDate, formatPeriod, t, type Lang} from '../lib/i18n.ts'
import type {Timesheet} from '../lib/timesheet.ts'
import MainAndSide from './MainAndSide.astro'
import FullWidth from './FullWidth.astro'
import PropertyList from './PropertyList.astro'

interface Props {
	timesheet: Timesheet
	lang: Lang
}

const {timesheet, lang} = Astro.props
const properties: [string, string][] = [
	[t(lang, 'meta.project'), timesheet.project.id],
	[t(lang, 'meta.projectName'), timesheet.project.description],
	[t(lang, 'meta.period'), formatPeriod(lang, timesheet.period.start, timesheet.period.end)],
]
---
<section class="attachment">
	<MainAndSide>
		<h2 class="aside" slot="side">Anhang</h2>
		<h2>{t(lang, 'timesheet.title')}</h2>
	</MainAndSide>

	<PropertyList propertyList={properties}/>

	<FullWidth>

		<table class="hours">
			<thead>
			<tr>
				<th class="date">{t(lang, 'timesheet.date')}</th>
				<th>{t(lang, 'timesheet.description')}</th>
				<th class="number">{t(lang, 'timesheet.hours')}</th>
			</tr>
			</thead>
			<tbody>
			{timesheet.entries.map(entry => (
							<tr>
								<td class="date">{formatDate(lang, entry.date)}</td>
								<td>{entry.notes}</td>
								<td class="number">{formatAmount(lang, entry.hours)}</td>
							</tr>
			))}
			</tbody>
			<tfoot>
			<tr>
				<th colspan="2">{t(lang, 'timesheet.total')}</th>
				<td class="number">{formatAmount(lang, timesheet.total)}</td>
			</tr>
			</tfoot>
		</table>

	</FullWidth>
</section>

<style>
	.attachment {
		break-before: auto;
		break-inside: avoid-page;
		display: flex;
		flex-direction: column;
		gap: 1rlh;
	}

	h2 {
		font-weight: 500;
		break-after: avoid;

		&.aside {
			font-weight: 400;
			color: var(--accentColor);
		}
	}

	.date {
		white-space: nowrap;
		padding-right: 2em;
	}
</style>
