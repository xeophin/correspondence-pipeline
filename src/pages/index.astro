<footer>
<Columns>
<p>hanna beispiel example.org/studio</p>
	<p>Beispielweg 1 <br>8000 Zürich</p>
	<p>hanna@example.org <br> +41 44 000 00 00</p>
</Columns>
	</footer>

</body>
</html>

<style>
	:root {
		font-family: "Unica 77 LL", Inter, system-ui, sans-serif;
		font-size: 11pt;
		line-height: 1.45;
	}

	body {
				display: flex;
		flex-direction: column;
		gap: 1rlh;
	}

footer {
	font-size: 0.8rem;
}

</style>

<style is:global>
	h1, h2, h3 {
		font-size: inherit;
		margin: 0;
		line-height: 1rlh;
	}

	:root {
		--column-width: 9.5rem;
		--gutter-width: 3mm;
	}

	.columns {
		display: grid;
		grid-template-columns: [aside-start] var(--column-width) [aside-end gutter-start] var(--gutter-width) [gutter-end main-start] auto [main-end];

		* {
			//border: 1px solid salmon;
		}

		&.all-main {
			> * {
				grid-area: main;
			}
		}
	}

	.trim-line {
		text-box: trim-end cap alphabetic;
	}
</style>