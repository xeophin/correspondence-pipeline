<style>
	:root {
		font-family: "Unica 77 LL", Inter, system-ui, sans-serif;
		font-size: 11pt;
		line-height: 1.45;
	}

	.columns {
		display: grid;
		grid-template-columns: [aside-start] 7.75rem [aside-end gutter-start] 3mm [gutter-end main-start] auto [main-end];

		* {
			//border: 1px solid salmon;
		}

		&.all-main {
			> * {
				grid-area: main;
			}
		}
	}

	.trim-line {
		text-box: trim-end cap alphabetic;
	}


	.subject {
		margin-block: 1rlh;

		time {
			grid-area: aside;
			justify-self: end;
			color: darkmagenta;
		}

		h3 {
			grid-area: main;
			font-weight: 500;
		}

	}

	header {

		//text-transform: uppercase;
		font-size: 1.33rem;

		letter-spacing: 0.05ch;
	}

	h1, h2, h3 {
		font-size: inherit;
		margin: 0;
		line-height: 1rlh;
	}

	h1 {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		font-weight: 400;
align-items: center;

		> * {
			text-box: trim-both ex alphabetic;
		}

		.example-org {
			justify-self: end;
		}

		.slash {
			color: darkmagenta;
			text-box-edge: cap alphabetic;
			place-self: center;
			font-size: 1.5em;
			font-weight: 300;
		}
	}

	h2 {
		font-weight: 500;
		grid-area: main;
		text-box: trim-both cap alphabetic;
	}

	.address {
		display: flex;
		flex-direction: column;
		gap: 1rlh;

		address {
			font-style: normal;

			&.return-address
			{
				font-size: 0.8rem;
				padding-block-end: 1ex;
				border-bottom: 1px solid black;
			}

		}
	}


