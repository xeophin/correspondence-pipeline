---
interface Props {
	brand: `${string}/${string}`
	typeLine?: string
}

const { brand, typeLine } = Astro.props
const [first, second] = brand.split('/')
---

<header class="columns">
	<h1><span class="brand-first">{first}</span><span class="slash">/</span><span class="brand-second">{second}</span>
	</h1>
	{typeLine && <h1 class="document">{typeLine}</h1>}
</header>

<style>
	header {
		font-size: 1.33rem;
		letter-spacing: 0.05ch;
	}


	h1 {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		font-weight: 400;
		align-items: center;

		> * {
			text-box: trim-both ex alphabetic;
		}

		.brand-first {
			justify-self: end;
		}

		.slash {
			color: var(--accentColor);
			text-box-edge: cap alphabetic;
			place-self: center;
			font-size: 1.5em;
			font-weight: 300;
		}

			&.document {
		font-weight: 500;
		grid-area: main;
		text-box: trim-both cap alphabetic;
	}
	}


</style>
