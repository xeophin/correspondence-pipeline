import MainAndSide from '../components/MainAndSide.astro'
import FullWidth from '../components/FullWidth.astro'
import Columns from '../components/Columns.astro'
---

<html lang="de-CH">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width"/>
	<meta name="generator" content={Astro.generator}/>
	<title>Astro</title>
</head>
<body>


<Header>
	Rechnung
</Header>

<Address>
	Kibo Sportrehabilitation GmbH <br>
	Hessstrasse 105 <br>
	3000 Köniz / Liebefeld <br>
	Schweiz
</Address>

<Subject date="11. 12. 2026" subject="Unterhalt kibo-physio.ch 2026/27" />

<MainAndSide>
		<p>Liebe Something,</p>
		<p>This is, propably, just very small text. And this is okay. We can live with that.</p>
		<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Ad, aliquam aut doloribus eos exercitationem expedita
			ipsa libero magni maxime minima pariatur quaerat quia quis sed similique suscipit temporibus, totam veniam.</p>
		<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci alias illum laudantium maxime nemo nulla odit
			provident reiciendis? Cum eaque expedita laboriosam officiis optio reiciendis reprehenderit, sed sit totam
