---
import { SENDER } from '../lib/sender.ts'

interface Props {
	recipient: string[]
}

const { recipient } = Astro.props
---

<section class="address">
	<address class="return-address trim-line">
		{SENDER.name}, {SENDER.street}, {SENDER.zip} {SENDER.city}
	</address>
	<address class="recipient trim-line">
		{recipient.map(line => <span>{line}</span>)}
	</address>
</section>

<style>
	.address {
		display: flex;
		flex-direction: column;
		gap: 2mm;

		address {
			font-style: normal;
			white-space: nowrap;

			&.return-address {
				font-size: 0.8rem;
				padding-block-end: 1ex;
				border-bottom: 1px solid black;
			}

			&.recipient {
				display: flex;
				flex-direction: column;
				/* five lines must fit the 34 mm window (C5, SN 010130) */
				line-height: 1.3;
			}

		}
	}
</style>
