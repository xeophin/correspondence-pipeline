---
import MainAndSide from './MainAndSide.astro'

interface Props {
	date: string
	subject: string
}

const {date, subject} = Astro.props
---

<MainAndSide>
	<time slot="side" class="trim-line">{date}</time>
	<h2 class="trim-line">{subject}</h2>
</MainAndSide>

<style>


	time {
		color: var(--accentColor);
	}

	h2 {

		font-weight: 500;
	}


</style>
