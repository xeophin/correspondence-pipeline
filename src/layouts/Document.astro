---
import Header from '../components/Header.astro'
import Address from '../components/Address.astro'
import Subject from '../components/Subject.astro'
import MainAndSide from '../components/MainAndSide.astro'
import FullWidth from '../components/FullWidth.astro'
import ItemsTable from '../components/ItemsTable.astro'
import PageRules from '../components/PageRules.astro'
import type { LoadedLetter } from '../lib/letter-loader.ts'
import { formatDate, t } from '../lib/i18n.ts'
import { PAGE_MARGIN } from '../lib/page-css.ts'
import { SENDER } from '../lib/sender.ts'

type Props = LoadedLetter

const { doc, htmlBefore, htmlAfter } = Astro.props
const brand = doc.sender === 'business' ? 'example.org/studio' : 'hanna/beispiel'
const typeLabel = doc.type === 'invoice' ? t(doc.lang, 'type.invoice') : undefined
const documentLabel = doc.invoice ? `${typeLabel} ${doc.invoice.number}` : doc.title
const typeLine = doc.sender === 'business' ? documentLabel : undefined
const runningHeader = doc.invoice ? `${brand} · ${documentLabel}` : brand
const footerLines = [
	`${SENDER.name} · ${SENDER.street} · ${SENDER.zip} ${SENDER.city}`,
	`${SENDER.email} · ${SENDER.phone}`,
]

// Envelope window (C5, right; mm from the page's top-left): the address goes at
// 117–196 × 47–81, the subject below 95. Convert to the content box of page 1.
const addressTop = 49 - PAGE_MARGIN.top
const addressLeft = 117 - PAGE_MARGIN.left
const firstPageHeadHeight = 97 - PAGE_MARGIN.top
---

<!doctype html>
<html lang={doc.lang === 'de' ? 'de-CH' : 'en-CH'}>
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width"/>
	<title>{doc.subject}</title>
	<PageRules runningHeader={runningHeader} fileName={doc.fileName} footerLines={footerLines} lang={doc.lang}/>
</head>
<body>
	<div class="first-page-head" style={`--address-top: ${addressTop}mm; --address-left: ${addressLeft}mm; height: ${firstPageHeadHeight}mm`}>
		<Header sender={doc.sender} typeLine={typeLine}/>
		<div class="address-position">
			<Address recipient={doc.recipient}/>
		</div>
	</div>

	<Subject date={formatDate(doc.lang, doc.date)} subject={doc.subject}/>

	<MainAndSide>
		<div class="body" set:html={htmlBefore}/>
	</MainAndSide>

	{doc.invoice && (
		<FullWidth>
			<ItemsTable invoice={doc.invoice} lang={doc.lang}/>
		</FullWidth>
	)}

	{htmlAfter.trim() && (
		<MainAndSide>
			<div class="body" set:html={htmlAfter}/>
		</MainAndSide>
	)}
</body>
</html>

<style>
	:root {
		font-family: "Unica 77 LL", sans-serif;
		font-size: 11pt;
		line-height: 1.45;
	}

	body {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rlh;
	}

	.first-page-head {
		position: relative;
	}

	.address-position {
		position: absolute;
		top: var(--address-top);
		left: var(--address-left);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 1rlh;

		:global(p) {
			margin: 0;
		}
	}
</style>

<style is:global>
	h1, h2, h3 {
		font-size: inherit;
		margin: 0;
		line-height: 1rlh;
	}

	:root {
		--column-width: 9.5rem;
		--gutter-width: 3mm;
	}

	.columns {
		display: grid;
		grid-template-columns: [aside-start] var(--column-width) [aside-end gutter-start] var(--gutter-width) [gutter-end main-start] auto [main-end];

		&.all-main {
			> * {
				grid-area: main;
			}
		}
	}

	.trim-line {
		text-box: trim-end cap alphabetic;
	}
</style>
